<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Linked MusicBee interface follows the host project's analyzer policy. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS0649;CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/Shmembee.Infrastructure/Shmembee.Infrastructure.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/Shmembee.MusicBee/PlaylistSyncController.cs" Link="Host/PlaylistSyncController.cs" />
    <Compile Include="../../src/Shmembee.MusicBee/PlaylistReviewDraft.cs" Link="Host/PlaylistReviewDraft.cs" />
    <Compile Include="../../src/Shmembee.MusicBee/MusicBeeInterface.cs" Link="Host/MusicBeeInterface.cs" />
    <Compile Include="../../src/Shmembee.MusicBee/MusicBeeLibraryReader.cs" Link="Host/MusicBeeLibraryReader.cs" />
    <Compile Include="../../src/Shmembee.MusicBee/MusicBeePlaylistWriter.cs" Link="Host/MusicBeePlaylistWriter.cs" />
    <Compile Include="../../src/Shmembee.Windows/WpdSidecarPlaylistTransport.cs" Link="Host/WpdSidecarPlaylistTransport.cs" />
    <Compile Include="../../src/Shmembee.Windows/WpdDiagnosticJournal.cs" Link="Host/WpdDiagnosticJournal.cs" />
  </ItemGroup>
</Project>
